# Builds a project-specific sandbox image on top of a digest-pinned base
# worker image (BASE_IMAGE -- the locally built worker `make sandbox-image`
# prints, a tagged release image, or another project image), baking in a
# TARGET project's own
# Go module cache, npm package cache, Maven repository, Ruby gems, and/or pip packages. Fixes a real
# GitHub Codex App review finding on PR #51: the plain worker image
# bakes only this repo's own go.sum, and a sandboxed build_app.py run has
# no package-registry network at all (only the optional model relay --
# see internal/sandbox/relay.go, which is model-endpoint-only), so a
# target project needing any dependency the canonical image doesn't
# already have baked cannot build inside it, even though the same project
# built fine on the host before Docker containment was default-on. This
# Dockerfile's own build step runs on the HOST, which does have normal
# network access, so that is where the dependency resolution has to
# happen instead -- factoryd itself never gets a package-registry route,
# by design (see internal/sandbox/relay.go's own scope).
#
# Build context MUST be a clean staging directory containing only the
# manifest files below -- NEVER the target project's own root. A real
# project checkout can contain `.git`, `.env`, credentials, or anything
# else gitignored, and this file's own `COPY .` would commit all of it to
# an immutable image layer if pointed at that root; a later layer removing
# the copy does not remove those bytes from the image's history, and
# `make project-sandbox-image` pushes the result to a registry (found via
# a real GitHub Codex App review of PR #51 -- an earlier version of this
# file did exactly that). `make project-sandbox-image PROJECT_DIR=<path>`
# stages the manifests into a throwaway directory and builds from that:
#   stage=$(mktemp -d)
#   cp <target-project-root>/go.mod <target-project-root>/go.sum "$stage/"    # if present
#   cp <target-project-root>/package.json <target-project-root>/package-lock.json "$stage/"  # if present
#   cp <target-project-root>/requirements.txt "$stage/"  # if present
#   cp <target-project-root>/pom.xml "$stage/"  # if present
#   cp <target-project-root>/Gemfile <target-project-root>/Gemfile.lock "$stage/"  # if present
#   docker build -f <this repo>/internal/sandbox/Dockerfile.project \
#     --build-arg BASE_IMAGE=<canonical or another project image> \
#     -t <project>-worker:local "$stage"
# `make project-sandbox-image PROJECT_DIR=<path>` does exactly this and
# prints a locally-addressable digest-pinned reference to pass as
# -sandbox-image -- see that target's own comment for why a plain local
# tag can't be used directly. Prefer it over invoking `docker build`
# yourself.
#
# Supports Go (go.mod/go.sum), npm (package.json/package-lock.json), Maven
# (pom.xml), Ruby Bundler (Gemfile/Gemfile.lock), and pip (requirements.txt).
# Dependencies for each are resolved during this host-side image build and
# are available to offline worker runs.
# Found live, 2026-09-08: a real Python
# project (a notes app repo) whose own Makefile requires mypy for `make verify`'s
# lint step had no way to get it into a sandboxed run at all before this --
# the canonical base image only ever bakes what this repo's own toolchain
# needs (go/node/pi), never a target project's Python dev dependencies, so
# every such project silently failed lint inside the sandbox regardless of
# how it passed on the host. Unlike the Go/npm blocks below, this one
# installs into site-packages directly rather than only priming an offline
# cache: pip has no equivalent of "resolve now, install later from the
# resolved set" that plain `go build`/`npm install` already get for free
# from GOMODCACHE/npm's own cache, and a target project's own Python
# tooling (mypy included) must already be importable inside the sandbox --
# there is no separate offline "install step" build_app.py could run later
# the way there is for Go/npm. Add another `if [ -f ... ]; then ...; fi`
# block below for a different manifest (poetry.lock, Cargo.lock, ...) the
# same way.
#
# npm gets its own baked cache path here, deliberately not the base
# image's own $HOME/.npm: internal/sandbox/docker.go mounts an EMPTY
# tmpfs over /home/worker on every launch (see its own doc comment there),
# so anything baked under $HOME in any image is wiped before the worker
# ever runs. GOMODCACHE needs no such override -- the base Dockerfile
# already bakes it outside $HOME, at /usr/local/gomodcache, for exactly
# this reason, and this file inherits that setting unchanged.
#
# Toolchains. A build has no network and GOTOOLCHAIN=local, so the image's
# own toolchains are the only ones a verify command can use. When the
# project declares one the base image does not satisfy (go.mod's `go` line,
# .python-version, pyproject.toml's requires-python, a pom.xml's JDK and
# Maven, a Gemfile's Ruby and Bundler), `make project-sandbox-image` passes
# GO_MODE/PYTHON_MODE/JAVA_MODE/RUBY_MODE=replace with the official image to
# copy that toolchain from (`factoryd project-image-args`,
# internal/toolchain). With none, the stages below are the base image
# unchanged and the toolchain images are never pulled. Everything a stage
# installs lives under /usr or /opt, which the sandbox's filesystem policy
# opens read-only.
#
# Node is not replaced: the Pi, Codex and Copilot CLIs run on the image's
# Node, and it is the executable the sandbox's network policy admits.
ARG BASE_IMAGE
ARG GO_MODE=keep
ARG GO_IMAGE=${BASE_IMAGE}
ARG PYTHON_MODE=keep
ARG PYTHON_IMAGE=${BASE_IMAGE}
ARG JAVA_MODE=keep
ARG JAVA_IMAGE=${BASE_IMAGE}
ARG RUBY_MODE=keep
ARG RUBY_IMAGE=${BASE_IMAGE}

FROM ${GO_IMAGE} AS project-go
FROM ${PYTHON_IMAGE} AS project-python
FROM ${JAVA_IMAGE} AS project-java
FROM ${RUBY_IMAGE} AS project-ruby

FROM ${BASE_IMAGE} AS go-keep
FROM ${BASE_IMAGE} AS go-replace
USER root
# Removed first: a copy over the older tree would leave its files beside the
# newer ones.
RUN rm -rf /usr/local/go
COPY --from=project-go /usr/local/go /usr/local/go
RUN go version

FROM go-${GO_MODE} AS python-keep
FROM go-${GO_MODE} AS python-replace
ARG PYTHON_VERSION
USER root
# The project's interpreter, beside the base image's: python3, python and pip
# become its names. PYTHON_IMAGE is built on the base image's distribution, so
# the interpreter finds the C library it was linked against.
COPY --from=project-python /usr/local/bin/python${PYTHON_VERSION} /usr/local/bin/pip${PYTHON_VERSION} /usr/local/bin/
COPY --from=project-python /usr/local/lib/python${PYTHON_VERSION} /usr/local/lib/python${PYTHON_VERSION}
COPY --from=project-python /usr/local/lib/libpython${PYTHON_VERSION}.so.1.0 /usr/local/lib/
COPY --from=project-python /usr/local/include/python${PYTHON_VERSION} /usr/local/include/python${PYTHON_VERSION}
RUN set -e; cd /usr/local/bin; \
    ln -sf python${PYTHON_VERSION} python3; ln -sf python3 python; \
    ln -sf pip${PYTHON_VERSION} pip3; ln -sf pip3 pip; \
    ldconfig; python3 --version; pip --version
# buildgate's own build scripts run on the worker's python3, which is now the
# project's. Their test suite is run on it here, so an interpreter they do
# not work on fails this build and never a ticket.
COPY .buildgate-agent /tmp/buildgate-agent
RUN cd /tmp/buildgate-agent/agent/pi; \
    if ! HOME=/tmp python3 -m unittest discover -s tests -p '*_test.py' >/tmp/buildgate-agent-tests.log 2>&1; then \
        grep -E '^(ERROR|FAIL):|^Ran |^FAILED' /tmp/buildgate-agent-tests.log | head -40; \
        echo "buildgate's build scripts fail their own tests on Python ${PYTHON_VERSION}; this project's interpreter cannot run a build" >&2; \
        exit 1; \
    fi; \
    grep -E '^Ran ' /tmp/buildgate-agent-tests.log; \
    rm -rf /tmp/buildgate-agent /tmp/buildgate-agent-tests.log

# A JDK and Maven, from an official maven:<line>-eclipse-temurin-<major>
# image. Temurin's JDK carries its own libraries beside glibc, so it runs on
# the base image's distribution whichever one the maven image is built on.
# Maven's settings and local repository are the worker's environment's
# concern, not this image's.
FROM python-${PYTHON_MODE} AS java-keep
FROM python-${PYTHON_MODE} AS java-replace
USER root
RUN rm -rf /opt/java/openjdk /usr/share/maven
COPY --from=project-java /opt/java/openjdk /opt/java/openjdk
COPY --from=project-java /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk
# Maven's console library ships its Linux native code only inside its jar and
# extracts it to /tmp on every run, which the sandbox mounts noexec; laid out
# where `mvn` already looks (library.jansi.path), it loads from /usr instead.
RUN set -e; \
    for tool in /opt/java/openjdk/bin/*; do ln -sf "$tool" /usr/local/bin/; done; \
    ln -sf /usr/share/maven/bin/mvn /usr/local/bin/mvn; \
    for jar in /usr/share/maven/lib/jansi-*.jar; do \
        [ -f "$jar" ] || continue; \
        mkdir -p /tmp/jansi; cd /tmp/jansi; \
        jar xf "$jar" org/fusesource/jansi/internal/native/Linux; \
        if [ -d org/fusesource/jansi/internal/native/Linux ]; then \
            mkdir -p /usr/share/maven/lib/jansi-native; \
            cp -r org/fusesource/jansi/internal/native/Linux /usr/share/maven/lib/jansi-native/; \
        fi; \
        cd /; rm -rf /tmp/jansi; \
    done; \
    java -version; javac -version; mvn -v

# Ruby and the Bundler it ships, from the official ruby:<version>-<codename>
# image of the base image's distribution: its interpreter, libruby, standard
# library, default gems and headers, each executable its gems install under
# /usr/local/bin, libyaml with its header (psych compiles against it), and any
# shared library the interpreter or an extension needs that the base image
# lacks. `bundle install` compiles native extensions with the base image's C
# compiler and make; a base image without a compiler gets one here, while make
# is the base image's own (the worker's is built for the sandbox). Where
# gems go is the worker's environment's concern (BUNDLE_PATH), not this
# image's.
FROM java-${JAVA_MODE} AS ruby-keep
FROM java-${JAVA_MODE} AS ruby-replace
USER root
RUN --mount=type=bind,from=project-ruby,source=/,target=/ruby-image \
    set -e; \
    src=/ruby-image; \
    rm -rf /usr/local/lib/ruby /usr/local/lib/libruby.so* /usr/local/include/ruby-*; \
    cp -a "$src"/usr/local/lib/ruby /usr/local/lib/; \
    cp -a "$src"/usr/local/lib/libruby.so* /usr/local/lib/; \
    cp -a "$src"/usr/local/include/ruby-* /usr/local/include/; \
    mkdir -p /usr/local/lib/pkgconfig; \
    cp -a "$src"/usr/local/lib/pkgconfig/ruby*.pc /usr/local/lib/pkgconfig/; \
    for tool in "$src"/usr/local/bin/*; do \
        if [ "${tool##*/}" = ruby ] || [ "$(head -c 21 "$tool")" = '#!/usr/local/bin/ruby' ]; then cp -a "$tool" /usr/local/bin/; fi; \
    done; \
    cp -a "$src"/usr/include/yaml.h /usr/include/; \
    for lib in "$src"/usr/lib/*/libyaml*; do cp -a "$lib" "${lib#"$src"}"; done; \
    ldconfig; \
    missing="$( { ldd /usr/local/bin/ruby; find /usr/local/lib/ruby -name '*.so' -exec ldd {} + ; } | awk '/not found/ { print $1 }' | sort -u)"; \
    for lib in $missing; do \
        found="$(find "$src"/lib "$src"/usr/lib -name "$lib" | head -n 1)"; \
        if [ -z "$found" ]; then echo "$lib, which Ruby needs, is in neither the base image nor $src" >&2; exit 1; fi; \
        cp -L "$found" "${found#"$src"}"; echo "copied $lib from the ruby image"; \
    done; \
    ldconfig; \
    if { ldd /usr/local/bin/ruby; find /usr/local/lib/ruby -name '*.so' -exec ldd {} + ; } | grep 'not found'; then exit 1; fi; \
    if ! command -v cc >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*; \
    fi; \
    command -v make >/dev/null || echo "warning: the base image has no make; a gem with a native extension cannot be compiled in it" >&2; \
    ruby -v; gem -v; bundle -v; \
    ruby -rpsych -rjson -ropenssl -rzlib -e 'puts "ruby standard library loads"'

# The base image with the project's toolchains and nothing of the project
# itself: what factoryd builds on its own for a build (--target toolchains).
FROM ruby-${RUBY_MODE} AS toolchains
USER 65532:65532

FROM toolchains
USER root

# npm and Maven write to their caches even when everything they need is
# already there, and the sandbox's filesystem policy keeps /usr read-only. So
# their caches live under /scratch: each launch mounts a fresh volume there,
# which Docker seeds with this image's /scratch, so every launch gets its own
# writable copy of what was baked (an empty one for a project that has none).
ENV npm_config_cache=/scratch/npm-cache
ENV MAVEN_OPTS="-Dmaven.repo.local=/scratch/maven-repository"
ENV BUNDLE_PATH=/usr/local/bundle

# Safe only because the build context is the staged manifests-only
# directory described above, never the target project's own root.
COPY . /tmp/project-src/
RUN --mount=type=secret,id=build-ca,required=false \
    set -e; \
    if [ -f /run/secrets/build-ca ]; then \
        export SSL_CERT_FILE=/run/secrets/build-ca \
            NODE_EXTRA_CA_CERTS=/run/secrets/build-ca \
            PIP_CERT=/run/secrets/build-ca; \
    fi; \
    mkdir -p /scratch/npm-cache /scratch/maven-repository /usr/local/bundle; \
    cd /tmp/project-src; \
    if [ -f go.mod ]; then \
        echo "baking Go module cache from go.mod"; \
        go mod download; \
    fi; \
    if [ -f package-lock.json ]; then \
        echo "baking npm cache from package-lock.json"; \
        npm ci --ignore-scripts; \
    fi; \
    if [ -f requirements.txt ]; then \
        echo "installing pip packages from requirements.txt"; \
        pip install --no-cache-dir -r requirements.txt; \
    fi; \
    if [ -f pom.xml ]; then \
        echo "baking Maven dependencies from pom.xml"; \
        mvn -B -ntp -DskipTests dependency:go-offline; \
        mvn -B -ntp -DskipTests test; \
        mvn -B -ntp org.apache.maven.plugins:maven-dependency-plugin:3.6.1:get \
            -Dartifact=org.apache.maven.surefire:surefire-junit4:2.22.2 \
            -Dtransitive=true; \
    fi; \
    if [ -f Gemfile.lock ]; then \
        echo "baking Ruby dependencies from Gemfile.lock"; \
        gem install bundler --no-document --version 2.4.22; \
        bundle _2.4.22_ install --jobs 4 --retry 3; \
    fi; \
    cd /; \
    rm -rf /tmp/project-src /tmp/buildgate-agent; \
    chmod -R a+rX /usr/local/gomodcache /usr/local/bundle; \
    chown -R 65532:65532 /scratch; \
    chmod 770 /scratch

USER 65532:65532
