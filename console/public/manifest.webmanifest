{
  "id": "/",
  "name": "Buildgate",
  "short_name": "Buildgate",
  "description": "The Buildgate operator console: requests, reviews, builds and runs.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1c1917",
